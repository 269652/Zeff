import fs from "node:fs";
import path from "node:path";

/**
 * Writes src/plugins/index.generated.ts (one import per src/plugins/<id>/plugin.ts) and
 * server.generated.ts (one per <id>/server.ts, for what a plugin brings that is code). A plugin is
 * added by creating its folder and running this (`npm run plugins:index`); tests/plugin-index.test.ts
 * fails while they are stale. `--check` only compares.
 */
const scan = (root: string) => fs.readdirSync(root, { withFileTypes: true }).filter((e) => e.isDirectory()).map((e) => e.name).sort();
const v = (d: string) => "p_" + d.replace(/[^a-z0-9]/g, "_");
const pluginsDir = () => path.join(process.cwd(), "src", "plugins");

/** plugins/index.generated.ts — the manifests (client-safe: data only). */
export function renderManifests(root = pluginsDir()): string {
  const ids = scan(root).filter((d) => fs.existsSync(path.join(root, d, "plugin.ts")));
  return [
    "// GENERATED by `npm run plugins:index` from src/plugins/*/plugin.ts — do not edit.",
    ...ids.map((d) => `import ${v(d)} from "./${d}/plugin";`),
    "",
    "/** Every built-in plugin's manifest (unsorted; plugins/catalog.ts orders them). */",
    `export const BUILTIN_MANIFESTS = [${ids.map(v).join(", ")}] as const;`,
    "",
  ].join("\n");
}

/** plugins/server.generated.ts — each plugin's server.ts, imported for what it registers (server only). */
export function renderServer(root = pluginsDir()): string {
  const ids = scan(root).filter((d) => fs.existsSync(path.join(root, d, "server.ts")));
  return ["// GENERATED by `npm run plugins:index` from src/plugins/*/server.ts — do not edit.", ...ids.map((d) => `import "./${d}/server";`), ""].join("\n");
}

if (process.argv[1]?.endsWith("plugins-index.mts")) {
  const dir = pluginsDir();
  const outputs: [string, string][] = [
    [path.join(dir, "index.generated.ts"), renderManifests()],
    [path.join(dir, "server.generated.ts"), renderServer()],
  ];
  let stale = false;
  for (const [file, next] of outputs) {
    if (process.argv.includes("--check")) {
      const cur = fs.existsSync(file) ? fs.readFileSync(file, "utf8").replace(/\r\n/g, "\n") : "";
      if (cur !== next) {
        console.error(`${path.relative(process.cwd(), file)} is stale — run \`npm run plugins:index\`.`);
        stale = true;
      }
    } else {
      fs.writeFileSync(file, next);
      console.log("wrote", path.relative(process.cwd(), file));
    }
  }
  if (stale) process.exit(1);
}
