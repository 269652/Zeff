/**
 * Correlations' port, kept in step with the built-in: its pure core (src/plugins/correlations/core.ts, engine.ts, stats.ts, the kernel's
 * findSeries) bundled by esbuild into the plugin's lambdas' shared library (zeff-plugins/plugins/correlations-ext/lambdas/_lib.mjs),
 * with the German and Spanish texts it says (taken from the language packs). So the built-in and the port say the same, word for word.
 *
 *   npx tsx scripts/port-correlations.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const out = path.join(repo, "plugins", "correlations-ext", "lambdas", "_lib.mjs");
const SOURCES = ["src/plugins/correlations/core.ts", "src/plugins/correlations/engine.ts"];

// The texts the core says: every t("…") in its sources, translated by the language packs.
const keys = new Set<string>();
for (const f of SOURCES) for (const m of fs.readFileSync(path.join(ROOT, f), "utf8").matchAll(/\bt\(\s*"((?:[^"\\]|\\.)*)"/g)) keys.add(JSON.parse(`"${m[1]}"`));
const strings: Record<string, Record<string, string>> = {};
for (const lang of ["de", "es"]) {
  const pack = JSON.parse(fs.readFileSync(path.join(repo, "plugins", `lang-${lang}`, "bundle.json"), "utf8")) as Record<string, string>;
  strings[lang] = Object.fromEntries([...keys].filter((k) => pack[k]).map((k) => [k, pack[k]]));
}

const entry = `
export * from "@/plugins/correlations/core";
export { analyze, comparePair, num, MIN_DAYS } from "@/plugins/correlations/engine";
import { setPluginStrings, translator, isLang } from "@/lib/i18n/shared";
const STRINGS = ${JSON.stringify(strings)};
setPluginStrings((lang) => STRINGS[lang] ?? {});
/** A translator for the user's language (context.language): the texts the built-in says, in the same words. */
export const tFor = (lang) => translator(isLang(lang) ? lang : "en");
`;

const r = await build({
  stdin: { contents: entry, resolveDir: ROOT, loader: "ts", sourcefile: "correlations-port.ts" },
  bundle: true,
  format: "esm",
  platform: "neutral",
  target: "es2022",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
const banner = `// Generated by Zeff's scripts/port-correlations.mts from the built-in Correlations' pure core — don't change it here, change the core
// and generate it again: the built-in and this port say the same, word for word.\n`;
fs.mkdirSync(path.dirname(out), { recursive: true });
fs.writeFileSync(out, banner + r.outputFiles[0].text);
console.log(`${out}: ${r.outputFiles[0].text.length} bytes, ${keys.size} texts (de ${Object.keys(strings.de).length}, es ${Object.keys(strings.es).length})`);
