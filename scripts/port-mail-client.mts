/**
 * Mail & Chat's port, kept in step with the built-in: its pure view code (src/plugins/mail-client/view-data.ts, threads.ts — what the
 * mail client, the chat and the inbox work out of their rows) bundled by esbuild into the plugin's compute script
 * (zeff-plugins/plugins/mail-client-ext/compute.js), run in the browser by <data compute="mail-client-ext.mail|chat|inbox">. A few
 * fields more the port's screens read where the built-in had code of its own (the reply's operation, the ids to mark read, the snooze
 * times, a thread's size as text). One source: the built-in and the port work the same out of the same rows.
 *
 *   npx tsx scripts/port-mail-client.mts [<zeff-plugins folder>]     (default ../zeff-plugins)
 */
import fs from "node:fs";
import path from "node:path";
import { build } from "esbuild";

const ROOT = process.cwd();
const repo = path.resolve(process.argv[2] ?? "../zeff-plugins");
const out = path.join(repo, "plugins", "mail-client-ext", "compute.js");

const entry = `
import { chatAppData, inboxAppData, mailAppData } from "@/plugins/mail-client/view-data";
import { snoozeUntil } from "@/plugins/mail-client/threads";

// What the view hands the frame (compute-data.tsx) as the built-in's views hand view-data.ts. (A "selected" not picked yet: the first.)
const input = (i) => ({ rows: i.rows ?? [], props: i.props ?? [], state: { ...(i.state ?? {}), selected: (i.state ?? {}).selected || undefined }, previews: i.extras?.previews, reply: i.extras?.capabilities?.reply ?? [], now: i.now });

// The fields the port's screens read where the built-in had code: the reply's operation, the ids marked read when you picked an unread
// one, the conversation's own message when it isn't fetched.
function more(d, i) {
  d.imapAny = (i.rows ?? []).some((x) => String(x.cells.commconv ?? "").startsWith("imap:"));
  const c = d.current;
  if (!c) return d;
  const r = c.reply;
  if (r && r.kind === "mail") r.opType = r.account === "Gmail" ? "gmail-compose" : r.account === "E-Mail" ? "imap-send" : "mail-compose";
  if (r && r.kind === "chat") r.op = r.channel === "Teams" ? { type: "teams-message", to: r.chat } : r.channel === "WhatsApp" ? { type: "whatsapp-message", chat: r.chat } : { type: "signal-message", chat: r.chat };
  c.ids = c.ids ?? [c.id];
  c.fallbackList = [c.fallback];
  const mine = (i.rows ?? []).filter((x) => c.ids.includes(x.id));
  c.markIds = (i.state ?? {}).selected && mine.some((x) => x.cells.communread || x.cells.mailunread) ? c.ids : [];
  return d;
}

export const mail = (i) => more(mailAppData(input(i)), i);
export const chat = (i) => more(chatAppData(input(i)), i);
export function inbox(i) {
  const d = more(inboxAppData(input(i)), i);
  for (const x of Object.values(d.texts ?? {})) x.countLabel = x.count > 1 ? String(x.count) : "";
  d.snooze = { later: snoozeUntil("later"), tomorrow: snoozeUntil("tomorrow"), week: snoozeUntil("week") };
  return d;
}
`;

const r = await build({
  stdin: { contents: entry, resolveDir: ROOT, loader: "ts", sourcefile: "mail-client-port.ts" },
  bundle: true,
  format: "iife",
  globalName: "ZeffCompute",
  platform: "browser",
  target: "es2020",
  write: false,
  alias: { "@": path.join(ROOT, "src") },
  legalComments: "none",
});
const banner = `// Generated by Zeff's scripts/port-mail-client.mts from the built-in Mail & Chat's view code — don't change it here, change the
// built-in's view-data.ts and generate it again. Runs in the browser in a sandboxed frame of its own (no network, nothing of Zeff).\n`;
fs.mkdirSync(path.dirname(out), { recursive: true });
fs.writeFileSync(out, banner + r.outputFiles[0].text);
console.log(`${out}: ${r.outputFiles[0].text.length} bytes`);

// Its views: the built-in's templates as the port's (port.meta.ts), in English — Zeff shows their words in your language — and its manifest.
const { CHAT_VIEW, INBOX_VIEW, MAIL_VIEW } = await import("../src/plugins/mail-client/view-template.meta");
const { toPortMail } = await import("../src/plugins/mail-client/port.meta");
const t = ((s: string, vars?: Record<string, unknown>) => s.replace(/\{(\w+)\}/g, (_m, k: string) => String(vars?.[k] ?? `{${k}}`))) as import("../src/lib/i18n/shared").T;
const views = [
  { id: "mail", dataType: "mail", label: "Mail", icon: "✉", meta: MAIL_VIEW },
  { id: "chat", dataType: "message", label: "Chat", icon: "💬", meta: CHAT_VIEW },
  { id: "inbox", dataType: "inbox", label: "Inbox", icon: "📬", meta: INBOX_VIEW },
] as const;
const dir = path.dirname(out);
fs.mkdirSync(path.join(dir, "views"), { recursive: true });
for (const v of views) fs.writeFileSync(path.join(dir, "views", `${v.id}.html`), toPortMail(v.meta.defaultTemplate(t), v.id, t) + "\n");
const manifestFile = path.join(dir, "zeff-plugin.json");
const had = fs.existsSync(manifestFile) ? (JSON.parse(fs.readFileSync(manifestFile, "utf8")) as { version?: string }) : {};
const manifest = {
  $schema: "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
  id: "mail-client-ext",
  name: "Mail & Chat",
  version: had.version ?? "1.0.0",
  description: "Your mails and chats as a mail client, a chat and one inbox across channels: read, reply (or let the AI draft), snooze, archive, new inboxes. Made of the view language; the kernel sends.",
  author: "Zeff",
  apiVersion: 1,
  permissions: [],
  contributes: {
    compute: "compute.js",
    appViews: views.map((v) => ({ id: v.id, dataType: v.dataType, label: v.label, icon: v.icon, template: `views/${v.id}.html` })),
  },
};
fs.writeFileSync(manifestFile, JSON.stringify(manifest, null, 2) + "\n");
console.log(`${dir}: views ${views.map((v) => v.id).join(", ")}, manifest`);
