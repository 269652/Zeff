{
  "$schema": "http://127.0.0.1:9333/ext/sdk/zeff-plugin.schema.json",
  "id": "learn-ext",
  "name": "Learn (external)",
  "version": "1.0.1",
  "description": "Zeff's Learn as an external plugin: courses researched and planned as skill trees, a live teacher in every lesson, exercises, cards, experience, study times, lesson todos.",
  "author": "Zeff examples",
  "apiVersion": 1,
  "permissions": [],
  "contributes": {
    "functions": [
      {
        "name": "review",
        "title": "Review a card",
        "description": "SM-2: when a card comes back, from its state and the grade.",
        "runtime": "node",
        "file": "fn/review.js",
        "input": {
          "reps": "number",
          "lapses": "number",
          "ease": "number",
          "interval": "days",
          "grade": "again | hard | good | easy",
          "today": "YYYY-MM-DD (optional)"
        },
        "needs": [],
        "timeoutSeconds": 60
      },
      {
        "name": "game",
        "title": "The game",
        "description": "Levels, streak, daily goal and badges (op: level | streak | daily | badges).",
        "runtime": "node",
        "file": "fn/game.js",
        "input": {
          "op": "level | streak | daily | badges"
        },
        "needs": [],
        "timeoutSeconds": 60
      },
      {
        "name": "state",
        "title": "The skill tree",
        "description": "Years, phases, skills and steps of a course with their status, progress, paths and what to do next.",
        "runtime": "node",
        "file": "fn/state.js",
        "input": {
          "course": "title or id (optional)"
        },
        "needs": [
          "database:@learn-ext.i3",
          "database:@learn-ext.i2"
        ],
        "timeoutSeconds": 60
      },
      {
        "name": "award",
        "title": "Give experience",
        "description": "XP, level, streak, today's XP and badges of a course; an Activity row.",
        "runtime": "node",
        "file": "fn/award.js",
        "input": {
          "course": "title or id",
          "xp": "number",
          "why": "text"
        },
        "needs": [
          "call:learn-ext.game",
          "call:learn-ext.state",
          "database:@learn-ext.i2",
          "write:database:@learn-ext.i2",
          "write:database:@learn-ext.i5",
          "database:@learn-ext.i4",
          "database:@learn-ext.i10"
        ],
        "timeoutSeconds": 60
      },
      {
        "name": "master",
        "title": "Master a step",
        "description": "Tick a step and the skills, phases and years it completes; experience once; what it opens.",
        "runtime": "node",
        "file": "fn/master.js",
        "input": {
          "step": "title, row id or key"
        },
        "needs": [
          "call:learn-ext.state",
          "call:learn-ext.award",
          "database:@learn-ext.i3",
          "write:database:@learn-ext.i3"
        ],
        "timeoutSeconds": 60
      },
      {
        "name": "grade",
        "title": "Answer a card",
        "description": "Work out when the card comes back, write it, earn a little experience.",
        "runtime": "node",
        "file": "fn/grade.js",
        "input": {
          "card": "id or front text",
          "grade": "again | hard | good | easy"
        },
        "needs": [
          "call:learn-ext.review",
          "call:learn-ext.award",
          "database:@learn-ext.i4",
          "write:database:@learn-ext.i4"
        ],
        "timeoutSeconds": 60
      },
      {
        "name": "literature",
        "title": "Literature",
        "description": "Scholarly sources from OpenAlex, Semantic Scholar and arXiv.",
        "runtime": "node",
        "file": "fn/literature.js",
        "input": {
          "topic": "text"
        },
        "needs": [],
        "timeoutSeconds": 90
      },
      {
        "name": "plan",
        "title": "Plan a course",
        "description": "Research and plan a course (create, update for the person's interests, or anew): the plan is checked and repaired, branched out if it is a chain.",
        "runtime": "node",
        "file": "fn/plan.js",
        "input": {
          "course": "title",
          "topic": "text",
          "goal": "text",
          "known": "text",
          "space": "text",
          "sources": "[{ title, url, snippet }]",
          "mode": "create | update | anew",
          "note": "text"
        },
        "needs": [
          "ai",
          "call:learn-ext.state",
          "call:learn-ext.literature",
          "database:@learn-ext.i2",
          "write:database:@learn-ext.i2",
          "database:@learn-ext.i3",
          "write:database:@learn-ext.i3",
          "delete:database:@learn-ext.i3",
          "database:@learn-ext.i4",
          "delete:database:@learn-ext.i4",
          "database:@learn-ext.i10",
          "delete:database:@learn-ext.i10",
          "database:@learn-ext.i9",
          "delete:database:@learn-ext.i9",
          "database:@learn-ext.i20",
          "delete:database:@learn-ext.i20"
        ],
        "timeoutSeconds": 600
      },
      {
        "name": "exercise",
        "title": "An exercise",
        "description": "A widget for a lesson: an exercise set for the kit, or a widget of your own (checked, every mistake said).",
        "runtime": "node",
        "file": "fn/exercise.js",
        "input": {
          "step": "id or title",
          "title": "text",
          "spec": "exercise set (JSON)",
          "html": "a widget of your own",
          "libs": "[names]"
        },
        "needs": [
          "database:@learn-ext.i3",
          "write:database:@learn-ext.i10",
          "api:workspace.widgets.check"
        ],
        "timeoutSeconds": 60
      },
      {
        "name": "result",
        "title": "An exercise reported",
        "description": "Keeps the best score, every try with its answers and snapshot; doing better earns up to 5 XP an exercise.",
        "runtime": "node",
        "file": "fn/result.js",
        "input": {
          "exercise": "id",
          "score": "0..1",
          "answers": "JSON text",
          "snapshot": "html"
        },
        "needs": [
          "call:learn-ext.award",
          "database:@learn-ext.i3",
          "database:@learn-ext.i10",
          "write:database:@learn-ext.i10",
          "write:database:@learn-ext.i20"
        ],
        "timeoutSeconds": 60
      },
      {
        "name": "cards",
        "title": "Cards for a lesson",
        "description": "Cards that come back for review.",
        "runtime": "node",
        "file": "fn/cards.js",
        "input": {
          "step": "id or title",
          "cards": "[{ front, back }]"
        },
        "needs": [
          "database:@learn-ext.i3",
          "write:database:@learn-ext.i4"
        ],
        "timeoutSeconds": 60
      },
      {
        "name": "progress",
        "title": "Where the course stands",
        "description": "Level, steps by status, next steps, paths and interests, study times, sources, cards due.",
        "runtime": "node",
        "file": "fn/progress.js",
        "input": {
          "course": "title (optional)",
          "step": "title or key (optional)"
        },
        "needs": [
          "call:learn-ext.state",
          "database:@learn-ext.i2",
          "database:@learn-ext.i4"
        ],
        "timeoutSeconds": 60
      },
      {
        "name": "courses",
        "title": "The courses",
        "description": "Every course as a card: level, streak, cards due, how far the plan is.",
        "runtime": "node",
        "file": "fn/courses.js",
        "input": {},
        "needs": [
          "database:@learn-ext.i2",
          "database:@learn-ext.i3",
          "database:@learn-ext.i4"
        ],
        "timeoutSeconds": 120
      },
      {
        "name": "skillmap",
        "title": "The skill map",
        "description": "The skills as nodes of a graph (needs, phase, colour by path, state, progress) and the thread through them.",
        "runtime": "node",
        "file": "fn/skillmap.js",
        "input": {
          "course": "title (optional)"
        },
        "needs": [
          "call:learn-ext.state"
        ],
        "timeoutSeconds": 60
      },
      {
        "name": "lesson-context",
        "title": "The teacher's context",
        "description": "What the teacher's rules say about a lesson (course, place in the plan, goals, what is known, sources); the lesson counts as begun.",
        "runtime": "node",
        "file": "fn/lesson_context.js",
        "input": {
          "key": "the step's title or key"
        },
        "needs": [
          "database:@learn-ext.i3",
          "write:database:@learn-ext.i3",
          "database:@learn-ext.i2",
          "database:@learn-ext.i10",
          "api:workspace.widgets.guide"
        ],
        "timeoutSeconds": 60
      },
      {
        "name": "coursesetting",
        "title": "A course's settings",
        "description": "Interest per path, daily goal, study times, space.",
        "runtime": "node",
        "file": "fn/coursesetting.js",
        "input": {
          "course": "title"
        },
        "needs": [
          "database:@learn-ext.i2",
          "write:database:@learn-ext.i2",
          "call:learn-ext.studytimes"
        ],
        "timeoutSeconds": 60
      },
      {
        "name": "studytimes",
        "title": "Study times",
        "description": "The weekly slots of every course kept as appointments for four weeks in the calendar 'Learning'.",
        "runtime": "node",
        "file": "fn/studytimes.js",
        "input": {},
        "needs": [
          "database:@learn-ext.i2",
          "api:calendar.events",
          "api:calendar.event.add",
          "api:calendar.event.delete"
        ],
        "timeoutSeconds": 60
      },
      {
        "name": "upkeep",
        "title": "Upkeep",
        "description": "Steps ticked by hand get their experience; a review todo while cards are due; the calendar kept up to date.",
        "runtime": "node",
        "file": "fn/upkeep.js",
        "input": {},
        "needs": [
          "call:learn-ext.state",
          "call:learn-ext.award",
          "call:learn-ext.studytimes",
          "database:@learn-ext.i2",
          "write:database:@learn-ext.i2",
          "database:@learn-ext.i3",
          "write:database:@learn-ext.i3",
          "database:@learn-ext.i4",
          "api:todos.list",
          "api:todos.add"
        ],
        "timeoutSeconds": 300
      },
      {
        "name": "removecourse",
        "title": "Remove a course",
        "description": "A course with its steps, exercises, tries, cards and conversations.",
        "runtime": "node",
        "file": "fn/removecourse.js",
        "input": {
          "course": "title"
        },
        "needs": [
          "call:learn-ext.studytimes",
          "database:@learn-ext.i2",
          "delete:database:@learn-ext.i2",
          "database:@learn-ext.i3",
          "delete:database:@learn-ext.i3",
          "database:@learn-ext.i4",
          "delete:database:@learn-ext.i4",
          "database:@learn-ext.i10",
          "delete:database:@learn-ext.i10",
          "database:@learn-ext.i9",
          "delete:database:@learn-ext.i9",
          "database:@learn-ext.i20",
          "delete:database:@learn-ext.i20"
        ],
        "timeoutSeconds": 60
      },
      {
        "name": "schedule",
        "title": "Study time",
        "description": "One appointment (or several days in a row) in Zeff's calendar.",
        "runtime": "node",
        "file": "fn/schedule.js",
        "input": {
          "title": "text",
          "start": "2026-11-13T18:00",
          "minutes": "number",
          "days": "number"
        },
        "needs": [
          "api:calendar.event.add"
        ],
        "timeoutSeconds": 60
      },
      {
        "name": "lessontodo",
        "title": "A todo for a lesson",
        "description": "'Learn: <step>' on the todo list, its number kept on the step.",
        "runtime": "node",
        "file": "fn/lessontodo.js",
        "input": {
          "step": "id or title"
        },
        "needs": [
          "api:todos.add",
          "database:@learn-ext.i3",
          "write:database:@learn-ext.i3"
        ],
        "timeoutSeconds": 60
      }
    ],
    "flowActions": [
      {
        "name": "master",
        "label": "Master a step",
        "summary": "Ticks a step of a Learn course and what it completes, gives the experience once and names the steps it opens.",
        "group": "learn",
        "function": "master",
        "input": [
          {
            "name": "step",
            "type": "text",
            "required": true
          }
        ],
        "output": "{ step, gained, completed, opened }",
        "writes": true
      },
      {
        "name": "grade",
        "label": "Answer a card",
        "summary": "Schedules a card from the answer (again, hard, good, easy) and gives a little experience.",
        "group": "learn",
        "function": "grade",
        "input": [
          {
            "name": "card",
            "type": "text",
            "required": true
          },
          {
            "name": "grade",
            "type": "text",
            "required": true
          },
          {
            "name": "course",
            "type": "text"
          }
        ],
        "output": "{ card, due, interval, ease, gained, level }",
        "writes": true
      },
      {
        "name": "plan",
        "label": "Plan a course",
        "summary": "Researches and plans a course (costs tokens); mode create, update (interests, a note) or anew.",
        "group": "learn",
        "function": "plan",
        "input": [
          {
            "name": "course",
            "type": "text",
            "required": true
          },
          {
            "name": "topic",
            "type": "text"
          },
          {
            "name": "goal",
            "type": "text"
          },
          {
            "name": "known",
            "type": "text"
          },
          {
            "name": "space",
            "type": "text"
          },
          {
            "name": "sources",
            "type": "json"
          },
          {
            "name": "mode",
            "type": "text"
          },
          {
            "name": "note",
            "type": "text"
          }
        ],
        "output": "{ course, mode, steps, added, changed, removed, repaired }",
        "writes": true
      },
      {
        "name": "result",
        "label": "An exercise reported",
        "summary": "Keeps an exercise's best score, its tries and gives experience for doing better (at most 5 XP an exercise).",
        "group": "learn",
        "function": "result",
        "input": [
          {
            "name": "exercise",
            "type": "text",
            "required": true
          },
          {
            "name": "score",
            "type": "number",
            "required": true
          },
          {
            "name": "correct",
            "type": "number"
          },
          {
            "name": "total",
            "type": "number"
          },
          {
            "name": "note",
            "type": "text"
          },
          {
            "name": "done",
            "type": "boolean"
          },
          {
            "name": "answers",
            "type": "text"
          },
          {
            "name": "snapshot",
            "type": "text"
          }
        ],
        "output": "{ exercise, best, gain, level, notice }",
        "writes": true
      },
      {
        "name": "skillmap",
        "label": "The skill map",
        "summary": "The nodes of the skill map for a graph.",
        "group": "learn",
        "function": "skillmap",
        "input": [
          {
            "name": "course",
            "type": "text"
          }
        ],
        "output": "{ nodes, thread, walked, paths }",
        "writes": true
      },
      {
        "name": "progress",
        "label": "Where the course stands",
        "summary": "Level, steps, next steps, paths, study times, sources.",
        "group": "learn",
        "function": "progress",
        "input": [
          {
            "name": "course",
            "type": "text"
          },
          {
            "name": "step",
            "type": "text"
          }
        ],
        "output": "{ course, progress, nodes, next, pathList, slots, sources, cardsDue }",
        "writes": true
      },
      {
        "name": "courses",
        "label": "The courses",
        "summary": "Every course as a card: level, streak, cards due, how far the plan is.",
        "group": "learn",
        "function": "courses",
        "input": [],
        "output": "{ course, progress, nodes, next, pathList, slots, sources, cardsDue }",
        "writes": true
      },
      {
        "name": "setting",
        "label": "A course's settings",
        "summary": "Interest per path, daily goal, study times, space.",
        "group": "learn",
        "function": "coursesetting",
        "input": [
          {
            "name": "course",
            "type": "text",
            "required": true
          },
          {
            "name": "interest",
            "type": "text"
          },
          {
            "name": "level",
            "type": "number"
          },
          {
            "name": "dailyGoal",
            "type": "number"
          },
          {
            "name": "slotDay",
            "type": "number"
          },
          {
            "name": "slotTime",
            "type": "text"
          },
          {
            "name": "slotMinutes",
            "type": "number"
          },
          {
            "name": "slotRemove",
            "type": "number"
          },
          {
            "name": "space",
            "type": "text"
          }
        ],
        "output": "{ course, changed }",
        "writes": true
      },
      {
        "name": "remove",
        "label": "Remove a course",
        "summary": "A course with everything of it.",
        "group": "learn",
        "function": "removecourse",
        "input": [
          {
            "name": "course",
            "type": "text",
            "required": true
          }
        ],
        "output": "{ course, removed }",
        "writes": true
      },
      {
        "name": "schedule",
        "label": "Study time",
        "summary": "Puts a study time into Zeff's own calendar.",
        "group": "learn",
        "function": "schedule",
        "input": [
          {
            "name": "title",
            "type": "text",
            "required": true
          },
          {
            "name": "start",
            "type": "text",
            "required": true
          },
          {
            "name": "minutes",
            "type": "number"
          },
          {
            "name": "days",
            "type": "number"
          }
        ],
        "output": "{ count, events }",
        "writes": true
      },
      {
        "name": "lessontodo",
        "label": "A todo for a lesson",
        "summary": "Makes a todo 'Learn: <step>' once.",
        "group": "learn",
        "function": "lessontodo",
        "input": [
          {
            "name": "step",
            "type": "text",
            "required": true
          }
        ],
        "output": "{ todo, made }",
        "writes": true
      }
    ],
    "chats": [
      {
        "id": "lesson",
        "title": "Lesson",
        "rules": "teacher.md",
        "context": "lesson-context",
        "tools": [
          "workspace_call_function",
          "workspace_functions"
        ],
        "conversation": {
          "database": "@learn-ext.i9",
          "text": "Text",
          "role": "Role",
          "key": "Step",
          "kind": "Kind",
          "run": "Run",
          "order": "Order",
          "at": "At",
          "roles": {
            "you": "you",
            "agent": "teacher",
            "system": "system"
          },
          "watch": [
            {
              "function": "exercise",
              "kind": "exercise",
              "field": "title"
            },
            {
              "function": "master",
              "kind": "mastered"
            }
          ]
        }
      }
    ],
    "schedules": [
      {
        "id": "upkeep",
        "function": "upkeep",
        "everyMinutes": 60
      }
    ],
    "workspacePackages": [
      "learn.package.json"
    ]
  }
}
