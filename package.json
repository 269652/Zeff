{
  "name": "zeff",
  "version": "0.1.4",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "integrations": "node scripts/integrations.mjs",
    "predev": "node scripts/integrations.mjs && tsx scripts/plugins-index.mts",
    "prebuild": "node scripts/integrations.mjs && tsx scripts/plugins-index.mts",
    "pretest": "node scripts/integrations.mjs && tsx scripts/plugins-index.mts",
    "pretypecheck": "node scripts/integrations.mjs && tsx scripts/plugins-index.mts",
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\" \"integrations/*/tests/**/*.test.ts\"",
    "test:server": "node scripts/test-server.mjs",
    "test:servers": "node scripts/test-server.mjs --list",
    "e2e": "node e2e/run.mjs",
    "companion:check": "node companion/check.cjs",
    "companion:deploy": "node scripts/companion-deploy.mjs",
    "phone:deploy": "node scripts/phone-deploy.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:sync": "node scripts/deploy.mjs --sync-host",
    "claude:up": "node scripts/claude-docker.mjs --up",
    "claude:down": "node scripts/claude-docker.mjs --down",
    "claude:build": "node scripts/claude-docker.mjs --build",
    "claude:status": "node scripts/claude-docker.mjs --status",
    "eval": "tsx scripts/eval.mts",
    "eval:mail": "tsx scripts/eval.mts mail",
    "i18n": "tsx scripts/i18n.mts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "serve": "next start -H 127.0.0.1 -p 9333",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1 -Install",
    "autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1 -Uninstall",
    "autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1 -Status",
    "knowledge:dev": "next dev knowledge -H 127.0.0.1 -p 9555",
    "knowledge:build": "next build knowledge",
    "knowledge:start": "next start knowledge -H 127.0.0.1 -p 9555",
    "launcher:build": "node scripts/dist.mjs --launcher-only",
    "dist": "node scripts/dist.mjs",
    "release": "node scripts/dist.mjs --release",
    "plugin:check": "tsx scripts/plugin-check.mts",
    "plugins:index": "tsx scripts/plugins-index.mts",
    "check:generated": "tsx scripts/plugins-index.mts --check && node scripts/integrations.mjs --check",
    "plugin:schema": "tsx scripts/plugin-schema.mts",
    "release:check": "node scripts/smoke-release.mjs",
    "publish:github": "node scripts/publish-github.mjs",
    "launcher:start": "npm --prefix launcher start"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-details": "^3.32.0",
    "@tiptap/extension-drag-handle-react": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "better-sqlite3": "^13.0.3",
    "css-select": "^7.0.0",
    "d3-force": "^3.0.0",
    "date-fns": "^4.4.0",
    "domutils": "^4.0.2",
    "drizzle-orm": "^0.45.2",
    "htmlparser2": "^10.1.0",
    "imapflow": "^2.11.0",
    "lowlight": "^3.3.0",
    "mailparser": "^3.14.2",
    "mcp-handler": "^2.2.0",
    "monaco-editor": "^0.52.2",
    "next": "16.3.5",
    "nodemailer": "^10.3.1",
    "playwright-core": "^1.63.0",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
