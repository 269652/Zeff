{
  "name": "zeff",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "integrations": "node scripts/integrations.mjs",
    "predev": "node scripts/integrations.mjs",
    "prebuild": "node scripts/integrations.mjs",
    "pretest": "node scripts/integrations.mjs",
    "pretypecheck": "node scripts/integrations.mjs",
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\" \"integrations/*/tests/**/*.test.ts\"",
    "deploy": "node scripts/deploy.mjs",
    "eval:mail": "tsx scripts/eval-mail-review.mts",
    "i18n": "tsx scripts/i18n.mts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "serve": "next start -H 127.0.0.1 -p 9333",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1 -Install",
    "autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1 -Uninstall",
    "autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1 -Status",
    "knowledge:dev": "next dev knowledge -H 127.0.0.1 -p 9555",
    "knowledge:build": "next build knowledge",
    "knowledge:start": "next start knowledge -H 127.0.0.1 -p 9555",
    "launcher:build": "node scripts/dist.mjs --launcher-only",
    "dist": "node scripts/dist.mjs",
    "release": "node scripts/dist.mjs --release",
    "plugin:check": "tsx scripts/plugin-check.mts",
    "plugins:index": "tsx scripts/plugins-index.mts",
    "plugin:schema": "tsx scripts/plugin-schema.mts",
    "release:check": "node scripts/smoke-release.mjs",
    "launcher:start": "npm --prefix launcher start"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "d3-force": "^3.0.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "mcp-handler": "^2.2.0",
    "next": "16.3.5",
    "playwright-core": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
