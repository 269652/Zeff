# Path of the SQLite database file (created automatically). Default: ./data/zeff.db
# DATABASE_PATH=./data/zeff.db

# Optional: require "Authorization: Bearer <token>" on the MCP endpoint (/api/mcp).
# Leave unset for unauthenticated localhost use.
# ZEFF_MCP_TOKEN=change-me

# Optional: log every MCP request to the server console.
# ZEFF_MCP_VERBOSE=1
