# Path of the SQLite database file (created automatically). Default: ./data/zeff.db
# DATABASE_PATH=./data/zeff.db

# Optional: require "Authorization: Bearer <token>" on the MCP endpoint (/api/mcp).
# Leave unset for unauthenticated localhost use.
# ZEFF_MCP_TOKEN=change-me

# Optional: log every MCP request to the server console.
# ZEFF_MCP_VERBOSE=1

# --- Calendar import (Microsoft Graph) ------------------------------------------
# The "Import meetings" device-code sign-in needs NO configuration and NO app
# registration (it uses Microsoft's public Graph CLI client). Optionally pin the tenant:
# MS_TENANT_ID=organizations   # or your tenant GUID / domain, e.g. contoso.onmicrosoft.com
#
# Only if you bring your OWN Entra app registration and prefer the browser-redirect flow:
# MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MS_CLIENT_SECRET=            # only when the redirect URI is a "Web" platform
# MS_REDIRECT_URI=http://localhost:9333/api/calendar/callback   # default: <origin>/api/calendar/callback

# The bookmarklet bridge stores pushed events here (default: ./data/calendar-inbox.json):
# ZEFF_CALENDAR_INBOX=./data/calendar-inbox.json

# Development: read events from a JSON file (Graph calendarView shape) instead of Graph.
# ZEFF_CALENDAR_FIXTURE=./fixtures/calendar-example.json

# --- Jira sync (Analysis completion + ticket autocomplete) --------------------
# Zeff auto-reads a stdio "jira" (or "mcp-atlassian") server from .mcp.json,
# loading its envFile — so if that's set up, no config here is needed.
# To point Zeff at a different Jira MCP command instead, set:
# JIRA_MCP_COMMAND=uvx
# JIRA_MCP_ARGS=["mcp-atlassian"]
# JIRA_MCP_ENV={"JIRA_URL":"https://jira.example.com","JIRA_PERSONAL_TOKEN":"…"}
# JIRA_MCP_TOOL=jira_search        # tool name (default jira_search)
# JIRA_JQL=assignee = currentUser() ORDER BY updated DESC
# JIRA_FIELDS=summary,status,updated,resolutiondate,issuetype,priority,assignee
# JIRA_BASE_URL=https://jira.example.com   # for building ticket links
