# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# npm run deploy: the next build before the swap, the previous one after it
/.next-build/
/.next-old*/
# the disposable test servers' builds (scripts/test-server.mjs)
/.next-e2e*/
# the e2e suite's screenshots of failures
/e2e/artifacts/
# the sync host's own build (npm run deploy: .next-sync, the next one waiting in .next-sync-build, the previous in .next-sync-old) —
# compiled and compressed output: ignored, or Tailwind scans it and builds a class out of the bytes ("Parsing CSS source code failed")
/.next-sync/
/.next-sync-build/
/.next-sync-old/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# zeff: local SQLite database
/data/
/.deploy-db/

# local tooling, not part of the project
CLAUDE.md
/.claude/
scripts/.probe-*.mjs

# Knowledge server: its database and build
/knowledge/data/
/knowledge/.next/
/knowledge/.next-build/
/knowledge/.next-old/
/knowledge/next-env.d.ts

# Launcher (Electron) dependencies and the bundle
/launcher/node_modules/
/dist/

# which integrations are mounted (generated by scripts/integrations.mjs; per machine — src/plugins/*.generated.ts are committed, see scripts/plugins-index.mts)
/src/lib/integrations/mounted-*.ts

# a test server's build (the workspace tests start one: .next-ws-test)
/.next-ws-test/

# The phone app's offline bundle (scripts/companion-build.mjs)
companion/app/_zc/offline.js
companion/app/_zc/offline.css
companion/app/_zc/Geist-latin.woff2
